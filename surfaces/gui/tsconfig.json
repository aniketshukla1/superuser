{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    // `node` is here for the few tests that read a shipped file from disk — the
    // terminal layout invariant is a CSS fact, and vitest stubs CSS imports to an
    // empty string, so `?raw` cannot see it. Node-side code still lives outside src.
    "types": ["node"],
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

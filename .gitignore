# Backups of the old Electron demo (kept on disk, not in git history)
_archive/

# Node
node_modules/
dist/
dist-ssr/
*.local

# Rust / Tauri
src-tauri/target/
target/

# Env / secrets
.env
.env.*
!.env.example

# OS
.DS_Store
*.log

# Local app data (vault/db live in the OS app-data dir at runtime, but ignore any local copies)
/data/
*.sqlite
*.sqlite-journal

# Tauri generated
src-tauri/gen/
app-icon.png

# The desktop GUI
surfaces/gui/node_modules/
surfaces/gui/dist/

# graphify knowledge graph (generated; rebuild with `graphify update .`)
graphify-out/

# git worktrees live here; they are checkouts, never content to commit
.claude/worktrees/

# Agent scratch output (tool dumps, not content to commit)
outputs/

# Python bytecode
__pycache__/
*.pyc

# Pass-rate history written by the harness sweep; regenerated by every run.
HARNESS-HISTORY.json

# README captures before sizing; regenerate with scripts/readme-assets.py
docs/assets/raw/

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Superuser",
  "version": "0.1.0",
  "identifier": "ai.superuser.app",
  "build": {
    "beforeDevCommand": "SUPERUSER_STATE_DIR=\"$HOME/Library/Application Support/ai.superuser.app\" npm --prefix surfaces/gui run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm --prefix surfaces/gui run build",
    "frontendDist": "../surfaces/gui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "13.0"
    }
  }
}
